# dependencies
node_modules/

# environment — never commit secrets
.env
.env.*
!.env.example
memory
# build output
dist/
*.js.map
# Generated into site/ by `npm run build:site` (the Pages deployment, or a
# local preview that wants the same files the deployed pages link to)
site/downloads/*.zip
site/install.sh

# agent scratch
.marshall/

# packages/engine/src/plugins.test.ts writes real fixture plugins here (needs
# to be inside the repo tree so bare specifiers like '@modelcontextprotocol/sdk'
# resolve) and cleans them up itself, but a killed test run can leave one behind
.tmp-plugin-fixture-*/
.tmp-plugin-bad-*/

# editor
.claude/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
marketing.md
plan.md
menu-plan.md
review-feedback.md
config-issues.md

# generated package and benchmark artifacts
*.tgz
bench/*.log
bench/results.json
# benchmark run artifacts: ~600 MB of session/reasoning logs per sweep, regenerated
# by `npx tsx bench/run.ts` and meaningful only next to the run that produced them.
bench/runs/
__pycache__/
bench/.hc-*.png
bench/harness-comparison.html
bench/harness-comparison.md
# pi persists API keys into its config dir; ship the empty template instead
bench/pi-config/auth.json
