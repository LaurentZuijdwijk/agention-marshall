{
  "name": "@agentionai/marshall-tools",
  "version": "0.6.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@agentionai/agents": "1.6.0-beta.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
