{
  "name": "@agentionai/marshall-engine",
  "version": "0.13.4",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/fake-provider.js",
      "types": "./dist/testing/fake-provider.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@agentionai/agents": "1.7.0-beta.0",
    "@agentionai/marshall-tools": "*",
    "@anthropic-ai/sdk": "^0.71.2",
    "@google/generative-ai": "^0.24.0",
    "@mistralai/mistralai": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
